# Enterprise AI Agent Execution and Telemetry System — Environment Config
# Rename this file to .env and fill in your values.

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
EAETS_OPENROUTER_API_KEY=

# ── LLM Settings ─────────────────────────────────────────────────────────────
# Any model slug from https://openrouter.ai/models
EAETS_LLM_MODEL=openai/gpt-4o
EAETS_LLM_TEMPERATURE=0.7
EAETS_LLM_MAX_TOKENS=1024

# ── Server ────────────────────────────────────────────────────────────────────
EAETS_HOST=0.0.0.0
EAETS_PORT=8000
EAETS_DEBUG=false

# ── Agent Execution ───────────────────────────────────────────────────────────
EAETS_MAX_CONCURRENT_AGENTS=10
EAETS_AGENT_TIMEOUT=300
EAETS_RETRY_LIMIT=3

# ── Weighting ─────────────────────────────────────────────────────────────────
EAETS_DEFAULT_AGENT_WEIGHT=1.0
EAETS_WEIGHT_DECAY=0.95
EAETS_PRIORITY_BOOST_VIP=10.0
EAETS_PRIORITY_BOOST_HIGH=3.0
EAETS_PRIORITY_BOOST_NORMAL=1.0
EAETS_PRIORITY_BOOST_LOW=0.25